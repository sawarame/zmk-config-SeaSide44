#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_MAC 0
#define DEFAULT_WIN 1
#define MOUSE 2
#define SCROLL_AND_FUNCTION 3
#define NUM_AND_SYMBOL 4
#define SHORTCUT_MAC 5
#define SHORTCUT_WIN 6
#define CONFIG 7

// OS設定を日本語キーボードのまま使用するための変換定義
#define JIS_EQUAL        UNDER             // =
#define JIS_PLUS         COLON             // +
#define JIS_COLON        SINGLE_QUOTE      // :
#define JIS_UNDERSCORE   LS(0x87)          // _
#define JIS_LBRACKET     RIGHT_BRACKET     // [
#define JIS_RBRACKET     BACKSLASH         // ]
#define JIS_LBRACE       RIGHT_BRACE       // {
#define JIS_RBRACE       PIPE              // }
#define JIS_YEN          0x89              // ¥
#define JIS_PIPE         LS(0x89)          // |
#define JIS_KANA         LANGUAGE_1        // かな
#define JIS_EISU         LANGUAGE_2        // 英数
#define JIS_HANZEN       GRAVE             // 半角/全角

#define JIS_BACKQUOTE    LEFT_BRACE        // `
#define JIS_TILDE        PLUS              // ~
#define JIS_AT           LEFT_BRACKET      // @
#define JIS_CARET        EQUAL             // ^
#define JIS_AMPERSAND    CARET             // &
#define JIS_ASTERISK     DOUBLE_QUOTES     // *
#define JIS_LPAR         ASTERISK          // (
#define JIS_RPAR         LEFT_PARENTHESIS  // )
#define JIS_DQUOTE       AT                // "
#define JIS_QUOTE        AMPERSAND         // '

&mt {
    flavor = "balanced";
    quick-tap-ms = <200>;
    tapping-term-ms = <150>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <200>;
    tapping-term-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        change_lang2 {
            bindings = <&kp LANG2>;
            key-positions = <14 15>;
        };

        change_lang1 {
            bindings = <&kp LANG1>;
            key-positions = <20 21>;
        };

        left_config {
            bindings = <&mo CONFIG>;
            key-positions = <15 16>;
        };

        right_config {
            bindings = <&mo CONFIG>;
            key-positions = <19 20>;
        };

    };

    macros {
        // エスケープキーと半角モード
        escape_lang2: escape_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &kp LANG2>;
            label = "ESCAPE_LANG2";
        };

        // Windowsのランチャー起動
        alt_space_lang2: alt_space_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LA(SPACE)) &kp LANG2>;
            label = "ALT_SPACE_LANG2";
        };
        
        // Macのランチャー起動
        command_space_lang2: command_space_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &kp LANG2>;
            label = "COMMAND_SPACE_LANG2";
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &to 0>;
            label = "BT_0";
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &bt BT_DISC 0 &bt BT_DISC 2 &bt BT_DISC 3 &to 0>;
            label = "BT_1";
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 3 &to 1>;
            label = "BT_2";
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &to 0>;
            label = "BT_3";
        };
    };

    behaviors {
        mthp: mthp {
            compatible = "zmk,behavior-hold-tap";
            label = "MTHP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <180>;
        };

        mt_escape: mt_escape {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_ESCAPE";
            bindings = <&kp>, <&escape_lang2>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer: 0
        DEFAULT_MAC {
            bindings = <
&trans  &kp Q        &kp W           &kp E           &kp R                        &kp T                                                                         &kp Y                   &kp U  &kp I                &kp O            &kp P            &trans
&trans  &kp A        &kp S           &kp D           &kp F                        &kp G                                                                         &kp H                   &kp J  &kp K                &lt MOUSE L      &kp SEMICOLON    &trans
&trans  &mt LCTRL Z  &mt LEFT_ALT X  &mt LEFT_GUI C  &kp V                        &kp B                                                                         &kp N                   &kp M  &mt RIGHT_GUI COMMA  &mt RALT PERIOD  &mt RCTRL SLASH  &trans
                                         &trans          &trans          &lt SCROLL_AND_FUNCTION TAB  &lt NUM_AND_SYMBOL SPACE  &mt_escape LSHIFT 0    &mthp RIGHT_SHIFT BACKSPACE  &lt SHORTCUT_MAC ENTER         &mo CONFIG
            >;
        };

        // Layer: 1 
        DEFAULT_WIN {
            bindings = <
&trans  &kp Q           &kp W           &kp E        &kp R                        &kp T                                                                         &kp Y                   &kp U  &kp I            &kp O            &kp P                &trans
&trans  &kp A           &kp S           &kp D        &kp F                        &kp G                                                                         &kp H                   &kp J  &kp K            &lt MOUSE L      &kp SEMICOLON        &trans
&trans  &mt LEFT_WIN Z  &mt LEFT_ALT X  &mt LCTRL C  &kp V                        &kp B                                                                         &kp N                   &kp M  &mt RCTRL COMMA  &mt RALT PERIOD  &mt RIGHT_WIN SLASH  &trans
                                            &trans          &trans       &lt SCROLL_AND_FUNCTION TAB  &lt NUM_AND_SYMBOL SPACE  &mt_escape LSHIFT 0    &mthp RIGHT_SHIFT BACKSPACE  &lt SHORTCUT_WIN ENTER         &mo CONFIG
            >;
        };

        // Layer: 2
        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB2  &trans  &trans  &trans 
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB3  &trans    &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans
            >;
        };

        // Layer: 3
        //  コマンドキーやオプションキーと同時押しが必要なキーはここには書かない
        SCROLL_AND_FUNCTION {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                    &kp F6              &kp F7              &kp F8            &kp F9                 &kp F10  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans                    &kp LEFT_ARROW      &kp DOWN_ARROW      &kp UP_ARROW      &lt 2 RIGHT_ARROW      &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans                    &kp LS(LEFT_ARROW)  &kp LS(DOWN_ARROW)  &kp LS(UP_ARROW)  &lt 2 LS(RIGHT_ARROW)  &trans   &trans
                 &trans   &trans  &trans  &trans  &trans    &trans  &trans                                  &trans
            >;
        };

        // Layer: 4
        NUM_AND_SYMBOL {
            bindings = <
&trans  &kp N1           &kp N2       &kp N3    &kp N4      &kp N5                         &kp N6            &kp N7             &kp N8        &kp N9     &kp N0         &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                    &kp CARET         &kp AMPERSAND      &kp ASTERISK  &kp LPAR   &kp RPAR       &trans
&trans  &kp GRAVE        &kp QUOTE    &trans    &trans      &trans                         &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp EQUAL     &kp MINUS  &kp BACKSLASH  &trans
                         &trans       &trans    &trans      &trans       &trans    &trans  &trans                               &trans
            >;
        };

        // Layer: 5 
        SHORTCUT_MAC {
            bindings = <
&trans  &trans                &trans                 &kp LG(LC(F))          &kp LC(UP_ARROW)  &trans                                        &trans      &kp LG(N0)            &kp LG(MINUS)             &kp LG(LS(EQUAL))          &kp LG(BACKSPACE)  &trans
&trans  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &kp LS(TAB)            &kp TAB           &kp Q                                         &trans      &kp LEFT_GUI          &kp LS(LG(LEFT_BRACKET))  &kp LS(LG(RIGHT_BRACKET))  &kp LG(Q)          &trans
&trans  &kp LG(Z)             &kp LG(X)              &kp LG(C)              &kp LG(V)         &trans                                        &kp LG(N4)  &command_space_lang2  &kp LC(LEFT_ARROW)        &kp LC(RIGHT_ARROW)        &trans             &trans
                              &trans                 &trans                 &kp LS(LG(N4))    &kp LS(LG(LC(N4)))  &kp LS(LG(N5))    &trans  &trans                            &trans
            >;
        };

        // Layer: 6
        SHORTCUT_WIN {
            bindings = <
&trans  &trans              &trans           &trans       &kp LG(TAB)  &trans                             &trans     &kp LC(N0)          &kp LC(MINUS)           &kp LC(EQUAL)            &kp DELETE  &trans 
&trans  &kp LA(LEFT_ARROW)  &kp LS(LC(TAB))  &kp LS(TAB)  &kp TAB      &trans                             &trans     &kp LEFT_ALT        &kp LS(LC(TAB))         &kp LC(TAB)              &kp LA(F4)  &trans
&trans  &kp LC(Z)           &kp LC(X)        &kp LC(C)    &kp LC(V)    &trans                             &kp LG(N)  &alt_space_lang2    &kp LG(LC(LEFT_ARROW))  &kp LG(LC(RIGHT_ARROW))  &trans      &trans
                            &trans           &trans       &trans       &kp LG(LS(S))   &trans     &trans  &trans                         &trans
            >;
        };
        
        // Layer: 7
        CONFIG {
            bindings = <
&trans  &bt_0           &bt_1          &bt_2          &bt_3          &trans                           &trans        &trans             &trans  &trans  &trans  &trans
&trans  &bt BT_DISC 0   &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4                    &kp C_BRI_UP  &kp C_VOLUME_UP    &trans  &trans  &trans  &trans
&trans  &bt BT_CLR      &trans         &trans         &trans         &trans                           &kp C_BRI_DN  &kp C_VOLUME_DOWN  &trans  &trans  &trans  &trans
                        &to 0          &to 1          &trans         &trans         &trans    &trans  &trans                           &trans
            >;
        };
    };
};



